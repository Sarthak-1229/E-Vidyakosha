{
  "name": "@evidy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "admin:bootstrap": "tsx src/commands/bootstrap-admin.ts",
    "files:reconcile": "tsx src/commands/reconcile-files.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@evidy/shared": "0.1.0",
    "content-disposition": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "jose": "^6.2.18",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "5.4.54",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server-core": "^11.4.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0"
  }
}
