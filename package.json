{
  "name": "e-vidyakosha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0 <27" },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev -w @evidy/api\" \"npm run dev -w @evidy/web\"",
    "build": "npm run build -w @evidy/shared && npm run build -w @evidy/api && npm run build -w @evidy/web",
    "start": "npm start -w @evidy/api -- --serve-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0"
  }
}
